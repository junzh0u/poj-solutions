#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 3 || $# -gt 4 || ! $1 =~ ^[0-9]+$ || ! -f $2 || -z $3 ]]; then
  echo "usage: build-submit-js <problem-id> <source-file> <model-id> [language]" >&2
  exit 2
fi

problem_id=$1
source_file=$2
expected_model=$3
language=${4:-4}

if [[ ! $language =~ ^[0-6]$ ]]; then
  echo "language must be a POJ language id 0-6 (0=G++ 4=C++)" >&2
  exit 2
fi

model_line_count=$(grep -c '^// Model:' "$source_file" || true)
if [[ $model_line_count -ne 1 ]] || ! grep -Fqx "// Model: $expected_model" "$source_file"; then
  echo "source must contain exactly one // Model: $expected_model line" >&2
  exit 2
fi

source_b64=$(base64 < "$source_file" | tr -d '\r\n')

payload=$(printf '%s\n' \
  "const src = atob('$source_b64');" \
  "const f = document.forms[2];" \
  "if (!f || f.problem_id.value !== '$problem_id') throw new Error('wrong or logged-out submit page');" \
  "f.language.value = '$language';" \
  "f.source.value = src;" \
  "if (f.source.value.length !== src.replace(/\r\n/g, '\n').length) throw new Error('source length mismatch');" \
  "f.elements['submit'].click();")

printf '%s' "$payload" | base64 | tr -d '\r\n'
printf '\n'
