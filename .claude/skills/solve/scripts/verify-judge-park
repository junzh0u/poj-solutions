#!/usr/bin/env python3
"""Summarize the public evidence behind a claimed judge park.

Usage: verify-judge-park <id> --html-out <path> [--rows N]

Runs the shared status helper with `--all-users` and reduces the newest N
rows (default 20) to the numbers the parent must weigh before writing a
`--kind judge` park: the verdict histogram, how many distinct users other
than 150014 are failing, and the newest Accepted row if any. The third
condition — this account accepting other problems in the same hour — is the
run's own record; no page here can show it. Interpretation stays with the
parent: this prints counts, not a verdict.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
from collections import Counter
from pathlib import Path

OWN_USER = "150014"


def main(arguments: list[str]) -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("problem_id")
    parser.add_argument("--html-out", type=Path, required=True)
    parser.add_argument("--rows", type=int, default=20)
    options = parser.parse_args(arguments[1:])

    helper = Path(__file__).resolve().parent / "status-via-curl"
    completed = subprocess.run(
        [
            str(helper),
            options.problem_id,
            "--all-users",
            "--html-out",
            str(options.html_out),
        ],
        check=False,
        capture_output=True,
        text=True,
    )
    if completed.returncode != 0:
        sys.stderr.write(completed.stderr)
        print(
            "verify-judge-park: status read failed — unknown state, not evidence",
            file=sys.stderr,
        )
        return 1

    rows = json.loads(completed.stdout)["rows"][: options.rows]
    if not rows:
        print(f"no rows on the all-users status page for {options.problem_id}")
        return 0

    verdicts = Counter(row["result"] for row in rows)
    histogram = ", ".join(f"{count} {result}" for result, count in verdicts.most_common())
    failing_users = {
        row["user"]
        for row in rows
        if row["result"] != "Accepted" and row["user"] != OWN_USER
    }
    accepted = next((row for row in rows if row["result"] == "Accepted"), None)

    print(f"newest {len(rows)} rows: {histogram}")
    print(f"window: {rows[-1]['submit_time']} .. {rows[0]['submit_time']}")
    print(f"distinct users other than {OWN_USER} failing: {len(failing_users)}")
    if accepted:
        print(
            f"newest Accepted: run {accepted['run_id']} by {accepted['user']}"
            f" at {accepted['submit_time']}"
        )
    else:
        print("newest Accepted: none in window")
    print(
        "still to confirm from this run's own record: accepts on other"
        " problems by this account in the same hour"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
